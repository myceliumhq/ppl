{
  "name": "@myceliumhq/ppl",
  "version": "0.1.0",
  "description": "Agent-facing CLI for paperless-ngx. Also ships a standalone MCP server for shell-less hosts.",
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "cli",
    "agent",
    "mcp",
    "paperless-ngx",
    "paperless",
    "document-management"
  ],
  "engines": {
    "node": "^20.0.0 || ^22.0.0 || >=24.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/myceliumhq/ppl.git"
  },
  "exports": {
    "./semantic-adapter": {
      "types": "./dist/semantic-adapter.d.ts",
      "default": "./dist/semantic-adapter.js"
    }
  },
  "bin": {
    "ppl": "./dist/cli/index.js",
    "ppl-semanticd": "./dist/semanticd-bin.js"
  },
  "files": [
    "dist",
    "skills"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc -p tsconfig.test.json",
    "generate:types": "tsx scripts/generate-types.ts",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "start:mcp": "node dist/mcp-server.js",
    "start:semanticd": "node dist/semanticd-bin.js",
    "prepublishOnly": "pnpm run build && pnpm run test"
  },
  "dependencies": {
    "@myceliumhq/toolkit": "^0.1.0",
    "@myceliumhq/index": "^0.1.0",
    "@myceliumhq/mcp": "^0.1.0",
    "@myceliumhq/semanticd": "^1.1.0",
    "openapi-fetch": "^0.17.0",
    "typebox": "^1.3.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@myceliumhq/dev-config": "^0.1.0",
    "@semantic-release/git": "^11.0.1",
    "@types/node": "^26.1.1",
    "openapi-typescript": "^7.13.0",
    "semantic-release": "^25.0.8",
    "tsx": "^4.23.1",
    "typescript": "7.0.2",
    "vitest": "^4.1.10"
  }
}
